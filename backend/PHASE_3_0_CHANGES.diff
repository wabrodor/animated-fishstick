@@ -0,0 +1,126 @@
+import mongoose from 'mongoose';
+import { CarePlan, CarePlanExecution, CarePlanMilestone, CareTask } from './models.js';
+
+export const CARE_PLAN_MILESTONE_DAYS = [0, 3, 7, 14, 30, 60, 90] as const;
+export type CarePlanMilestoneDay = typeof CARE_PLAN_MILESTONE_DAYS[number];
+
+export function milestoneKey(day: number): string {
+  return `DAY_${day}`;
+}
+
+export function taskKey(type: string, title: string, dueAt: Date): string {
+  const normalizedTitle = title.trim().toLowerCase().replace(/[^a-z0-9]+/g, '-').replace(/^-|-$/g, '').slice(0, 100);
+  return `${type}:${normalizedTitle || 'task'}:${dueAt.toISOString().slice(0, 10)}`;
+}
+
+export function getMilestoneDay(startDate: Date, dueAt: Date): number | null {
+  const start = Date.UTC(startDate.getUTCFullYear(), startDate.getUTCMonth(), startDate.getUTCDate());
+  const due = Date.UTC(dueAt.getUTCFullYear(), dueAt.getUTCMonth(), dueAt.getUTCDate());
+  const day = Math.round((due - start) / 86_400_000);
+  return CARE_PLAN_MILESTONE_DAYS.includes(day as CarePlanMilestoneDay) ? day : null;
+}
+
+export async function ensureCarePlanExecution(
+  input: {
+    organizationId: string;
+    patientId: string;
+    carePlanId: string;
+  },
+  session?: mongoose.ClientSession,
+) {
+  const plan = await CarePlan.findOne({
+    _id: input.carePlanId,
+    organizationId: input.organizationId,
+    patientId: input.patientId,
+    status: 'ACTIVE',
+  }).select('_id startDate endDate condition').session(session ?? null).lean();
+
+  if (!plan) return null;
+
+  let execution;
+  try {
+    execution = await CarePlanExecution.findOneAndUpdate(
+      { organizationId: input.organizationId, patientId: input.patientId, carePlanId: input.carePlanId },
+      {
+        $setOnInsert: {
+          organizationId: input.organizationId,
+          patientId: input.patientId,
+          carePlanId: input.carePlanId,
+          condition: plan.condition,
+          status: 'ACTIVE',
+          startDate: plan.startDate,
+          endDate: plan.endDate,
+          activationKey: `care-plan-execution:${input.carePlanId}`,
+        },
+      },
+      { upsert: true, new: true, setDefaultsOnInsert: true, session },
+    );
+  } catch (error) {
+    if ((error as { code?: number })?.code !== 11000) throw error;
+    execution = await CarePlanExecution.findOne({
+      organizationId: input.organizationId,
+      patientId: input.patientId,
+      carePlanId: input.carePlanId,
+    }).session(session ?? null);
+  }
+  if (!execution) throw new Error('CARE_PLAN_EXECUTION_CREATE_FAILED');
+
+  for (const day of CARE_PLAN_MILESTONE_DAYS) {
+    const dueAt = new Date(plan.startDate);
+    dueAt.setUTCDate(dueAt.getUTCDate() + day);
+    await CarePlanMilestone.updateOne(
+      { executionId: execution._id, day },
+      {
+        $setOnInsert: {
+          organizationId: input.organizationId,
+          patientId: input.patientId,
+          carePlanId: input.carePlanId,
+          executionId: execution._id,
+          key: milestoneKey(day),
+          day,
+          dueAt,
+          status: 'PLANNED',
+        },
+      },
+      { upsert: true, session },
+    );
+  }
+
+  return CarePlanExecution.findById(execution._id).session(session ?? null).lean();
+}
+
+export async function attachCarePlanTasksToExecution(
+  input: {
+    organizationId: string;
+    patientId: string;
+    carePlanId: string;
+    tasks: Array<{ _id: mongoose.Types.ObjectId; type: string; title: string; dueAt: Date }>;
+  },
+  session?: mongoose.ClientSession,
+) {
+  const execution = await CarePlanExecution.findOne({
+    organizationId: input.organizationId,
+    patientId: input.patientId,
+    carePlanId: input.carePlanId,
+  }).session(session ?? null).lean();
+  if (!execution) throw new Error('CARE_PLAN_EXECUTION_NOT_FOUND');
+
+  for (const task of input.tasks) {
+    const day = getMilestoneDay(execution.startDate, task.dueAt);
+    const milestone = day === null
+      ? null
+      : await CarePlanMilestone.findOne({ executionId: execution._id, day }).session(session ?? null).lean();
+
+    await CareTask.updateOne(
+      { _id: task._id, organizationId: input.organizationId, patientId: input.patientId, carePlanId: input.carePlanId },
+      {
+        $set: {
+          executionId: execution._id,
+          milestoneId: milestone?._id,
+          taskKey: taskKey(task.type, task.title, task.dueAt),
+        },
+      },
+      { session },
+    );
+  }
+}
