NODE_ENV=development
PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/apexcare
JWT_ACCESS_SECRET=replace-with-a-random-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
CORS_ORIGINS=http://localhost:3000
REDIS_URL=redis://127.0.0.1:6379

# Optional shared override; if unset, the existing PRESCRIPTION_STORAGE_PROVIDER is used.
# DOCUMENT_STORAGE_PROVIDER=s3

AI_ENABLED=false

# Start the plain PaddleOCR service with: docker compose --profile ocr up --build paddleocr
PRESCRIPTION_OCR_ENABLED=false
PRESCRIPTION_OCR_PROVIDER=paddleocr
PRESCRIPTION_OCR_BASE_URL=http://127.0.0.1:8080
# Set PRESCRIPTION_OCR_API_KEY to a long random internal token before enabling OCR.
PRESCRIPTION_OCR_TIMEOUT_MS=120000

# OCR transcription only is sent to DeepSeek when this is enabled. Keep the key secret.
PRESCRIPTION_STRUCTURING_ENABLED=false
PRESCRIPTION_STRUCTURING_BASE_URL=https://api.deepseek.com
# Set PRESCRIPTION_STRUCTURING_API_KEY only if legacy prescription structuring is enabled.
PRESCRIPTION_STRUCTURING_MODEL=deepseek-flash
PRESCRIPTION_STRUCTURING_TIMEOUT_MS=30000

# Optional shared DeepSeek structuring settings for prescription and lab candidates.
MEDICAL_DOCUMENT_STRUCTURING_ENABLED=false
MEDICAL_DOCUMENT_STRUCTURING_BASE_URL=https://api.deepseek.com
# Set MEDICAL_DOCUMENT_STRUCTURING_API_KEY only when document structuring is enabled.
MEDICAL_DOCUMENT_STRUCTURING_MODEL=deepseek-flash
MEDICAL_DOCUMENT_STRUCTURING_TIMEOUT_MS=30000
