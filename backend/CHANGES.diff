@@ -0,0 +1,38 @@

+import { Worker } from 'bullmq';
+import { redisConnection } from '../queues.js';
+import { CareTask } from '../models.js';
+
+const worker = new Worker(
+  'apexcare-reminders',
+  async (job) => {
+    if (job.name !== 'care-task-due') return;
+
+    const task = await CareTask.findById(job.data.taskId).lean();
+    if (!task || !['PENDING', 'OVERDUE'].includes(task.status)) return;
+
+    // Channel delivery (WhatsApp/SMS/push) belongs in the notification adapter.
+    // For this first workflow, the worker makes the reminder event reliable and
+    // observable without coupling the core API to a messaging provider.
+    console.log(JSON.stringify({
+      type: 'CARE_TASK_REMINDER_DUE',
+      taskId: String(task._id),
+      patientId: String(task.patientId),
+      organizationId: String(task.organizationId),
+      dueAt: task.dueAt,
+      taskType: task.type,
+    }));
+  },
+  { connection: redisConnection },
+);
+
+worker.on('completed', (job) => console.log(`Reminder job completed: ${job.id}`));
+worker.on('failed', (job, error) => console.error(`Reminder job failed: ${job?.id}`, error));
+
+const shutdown = async () => {
+  await worker.close();
+  await redisConnection.quit();
+  process.exit(0);
+};
+
+process.once('SIGINT', shutdown);
+process.once('SIGTERM', shutdown);

