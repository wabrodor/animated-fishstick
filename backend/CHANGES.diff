@@ -0,0 +1,28 @@

+import { Queue } from 'bullmq';
+import IORedis from 'ioredis';
+import { env } from './config.js';
+
+export const redisConnection = new IORedis(env.REDIS_URL, {
+  maxRetriesPerRequest: null,
+});
+
+export const reminderQueue = new Queue('apexcare-reminders', {
+  connection: redisConnection,
+});
+
+export async function scheduleCareTaskReminder(taskId: string, dueAt: Date): Promise<void> {
+  const reminderAt = new Date(dueAt);
+  reminderAt.setHours(reminderAt.getHours() - 24);
+  const delay = Math.max(0, reminderAt.getTime() - Date.now());
+
+  await reminderQueue.add(
+    'care-task-due',
+    { taskId },
+    {
+      delay,
+      jobId: `care-task-${taskId}`,
+      removeOnComplete: 1000,
+      removeOnFail: 5000,
+    },
+  );
+}
